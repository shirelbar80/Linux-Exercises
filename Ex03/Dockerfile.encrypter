FROM ubuntu:24.04

# התקנת ספריות שרק דרושות להרצה (לא לקומפילציה)
RUN apt-get update && apt-get install -y \
    libssl-dev \
    libpthread-stubs0-dev

# העתקת הקובץ הבינארי שכבר קימפלת לוקאלית
COPY encrypter /app/encrypter

# קביעת תיקיית העבודה
WORKDIR /app

# פקודת ברירת מחדל להרצה
CMD ["./encrypter"]




